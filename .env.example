# Khi dùng chung project Supabase với BizMate: URL/key của project BizMate
# (bảng CDILV là cdilv_* — xem supabase/cdilv_on_shared_project.sql)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Chỉ dùng trên server (API). Không đặt tiền tố NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Production canonical
NEXT_PUBLIC_SITE_URL=https://cdilv.vn

# Dev local (tuỳ chọn):
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
